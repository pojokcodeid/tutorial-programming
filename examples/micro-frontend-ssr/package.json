{
  "name": "micro-frontend-ssr-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lab SSR + hydration React 18 tanpa Module Federation: bandingkan CSR dan SSR pada katalog produk.",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "start": "NODE_ENV=production node server.mjs",
    "preview": "npm run build && npm start",
    "test": "npm run build && node --test test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  }
}
