# Salin file ini menjadi .env lalu sesuaikan.
# .env dibaca otomatis oleh package config saat aplikasi start.

# Port HTTP server
APP_PORT=8080

# Koneksi database MariaDB (development lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=gorestapi_app

# Secret untuk menandatangani JWT.
# GANTI nilai ini di produksi! (pakai random string panjang, mis. `openssl rand -hex 32`)
JWT_SECRET=dev-secret-ganti-saya
# Masa berlaku token dalam menit
JWT_EXPIRY_MINUTES=60
