{
  "name": "micro-frontend-webpack-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lab micro-frontend React 18 + TypeScript dengan Webpack 5 Module Federation dan varian Rspack.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "install": "npm install --ignore-scripts --no-audit --no-fund",
    "build": "npm run build --workspaces --if-present",
    "build:webpack": "npm run build --workspaces --if-present",
    "build:rspack": "npm run build:rspack --workspaces --if-present",
    "start": "node server.mjs",
    "test": "node --test test.mjs",
    "typecheck": "tsc -p apps/host/tsconfig.json --noEmit && tsc -p apps/remote/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.18"
  },
  "devDependencies": {
    "@module-federation/enhanced": "^2.9.2",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
