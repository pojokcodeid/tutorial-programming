# =============================================================
# Konfigurasi Framework MVC Lucee CFML
# -------------------------------------------------------------
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env TIDAK di-commit ke git (lihat .gitignore).
# =============================================================

# Nama aplikasi — juga menjadi this.name di Application.cfc
APP_NAME=cfml-mvc-framework

# URL dasar aplikasi — dipakai untuk link & redirect
APP_URL=http://localhost:8888

# Mode debug: true = tampilkan detail error, false = halaman error ramah
APP_DEBUG=false

# -------------------------------------------------------------
# Database (MariaDB / MySQL)
# -------------------------------------------------------------
# Class JDBC driver: org.mariadb.jdbc.Driver (MariaDB)
#                atau com.mysql.cj.jdbc.Driver (MySQL)
DB_DRIVER_CLASS=org.mariadb.jdbc.Driver
# Jenis koneksi untuk connectionString: mariadb | mysql
DB_TYPE=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=latihan
DB_USER=root
DB_PASSWORD=
# Jumlah koneksi maksimum di connection pool
DB_CONNECTION_LIMIT=5

# -------------------------------------------------------------
# Upload file (relatif terhadap webroot src/)
# -------------------------------------------------------------
UPLOAD_DIR=public/uploads
